{
  "name": "@partner-coder/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@partner-coder/config": "workspace:*",
    "@partner-coder/contracts": "workspace:*",
    "@partner-coder/db": "workspace:*",
    "@partner-coder/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
