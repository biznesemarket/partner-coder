{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner Coder API",
    "version": "0.0.1",
    "description": "API кабинетов и агентов. Ошибки возвращаются в конверте { error: { code, message, requestId } }."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Здоровье, готовность и метрики"
    },
    {
      "name": "Auth",
      "description": "Better Auth и выбор tenant"
    },
    {
      "name": "Invitations",
      "description": "Приглашения и членство"
    },
    {
      "name": "Devices",
      "description": "Device-токены агентов"
    },
    {
      "name": "Tenant",
      "description": "Данные рабочего пространства"
    }
  ],
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "fail",
                "skip"
              ]
            }
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checks"
        ],
        "additionalProperties": false
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "TenantIdBody": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "tenantId"
        ],
        "additionalProperties": false
      },
      "InvitationCreate": {
        "type": "object",
