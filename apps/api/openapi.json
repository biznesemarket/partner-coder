          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "director",
              "developer",
              "finance",
              "support"
            ]
          },
          "ttlMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 129600
          }
        },
        "required": [
          "email",
          "role"
        ],
        "additionalProperties": false
      },
