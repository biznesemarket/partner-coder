[Unit]
Description=Partner Coder web console
Documentation=https://github.com/biznesemarket/partner-coder
After=network-online.target partner-coder-api.service
Wants=network-online.target

[Service]
Type=simple
User=partner-coder
Group=partner-coder
WorkingDirectory=/opt/partner-coder
EnvironmentFile=/etc/partner-coder/web.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/pnpm --filter @partner-coder/web start
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/partner-coder/apps/web/.next/cache
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
