# ─────────────────────────────────────────────────────────────
# Локальное окружение (docker compose). Скопируйте в `.env`.
# Секреты в репозиторий не коммитятся (см. SECURITY.md).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=local

# PostgreSQL
DATABASE_URL=postgres://partner:partner@localhost:5432/partner_coder
DATABASE_POOL_MAX=10

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
VENDOR_BASE_URL=http://localhost:3001
# CORS: пусто — WEB_BASE_URL,VENDOR_BASE_URL
API_CORS_ORIGINS=
# /metrics: пусто — метрики открыты (local/staging)
METRICS_TOKEN=

# Аутентификация
# В staging/prod: логин роли partner_coder_auth (доступ только к auth-таблицам).
# Локально можно не задавать — будет использован DATABASE_URL.
AUTH_DATABASE_URL=
AUTH_SECRET=local-dev-only-change-me-0123456789abcdef
SESSION_TTL_HOURS=12
MAGIC_LINK_TTL_MINUTES=30
# За reverse-proxy: укажите заголовок, который перезаписывает edge, и доверенные
# адреса прокси. Без этого Better Auth доверяет одиночному X-Forwarded-For.
AUTH_IP_HEADERS=
AUTH_TRUSTED_PROXIES=

# Хранилище (MinIO, S3-совместимое)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central-1
S3_BUCKET=partner-coder
S3_ACCESS_KEY=partner
S3_SECRET_KEY=partner-secret
S3_FORCE_PATH_STYLE=true

# Почта (Mailpit локально)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Партнер кодер <no-reply@partnercoder.local>"

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Наблюдаемость (опционально)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Worker / pg-boss
WORKER_METRICS_PORT=4100
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
PG_BOSS_SCHEMA=pgboss
DAY_CLOSE_CRON=*/15 * * * *
DAY_CLOSE_CATCHUP_DAYS=31
AUDIT_ANCHOR_CRON=15 0 * * *
TTL_CLEANUP_CRON=30 * * * *
JOB_RETRY_LIMIT=5
AUTH_SESSION_RETENTION_DAYS=7
AUTH_VERIFICATION_RETENTION_DAYS=1
HEARTBEAT_RETENTION_DAYS=90

# MCP / пакет подключения
MCP_MIN_VERSION=0.1.0
PACKAGE_TTL_DAYS=7
