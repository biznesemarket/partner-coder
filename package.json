{
  "name": "partner-coder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Партнёр кодер — SaaS-платформа учета вклада разработчиков, работающих с ИИ-агентами",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "turbo run clean",
    "db:check": "pnpm --filter @partner-coder/db db:check",
    "db:generate": "pnpm --filter @partner-coder/db db:generate",
    "db:migrate": "pnpm --filter @partner-coder/db db:migrate",
    "db:studio": "pnpm --filter @partner-coder/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "lint": "eslint .",
    "seed": "pnpm build && pnpm --filter @partner-coder/seed seed",
    "test": "vitest run",
    "test:db": "vitest run packages/db/test tools/seed/test",
    "test:e2e": "node apps/web/e2e/prepare.mjs && pnpm --filter @partner-coder/web test:e2e",
    "test:e2e:full": "pnpm build && pnpm test:e2e",
    "test:golden": "vitest run packages/domain/src/golden.test.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "version": "changeset version"
  },
  "pnpm": {
    "overrides": {
      "esbuild@0.18.20": "0.28.2",
      "glob@10.5.0": "14.0.6",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.3",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
