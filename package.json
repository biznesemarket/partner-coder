{
  "name": "partner-coder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Партнер кодер — SaaS-платформа учета вклада разработчиков, работающих с ИИ-агентами",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "lint": "eslint .",
    "test": "vitest run",
    "test:golden": "vitest run packages/domain/src/golden.test.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "turbo": "^2.11.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
